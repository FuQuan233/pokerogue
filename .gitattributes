# Auto detect text files and perform LF normalization
* text=auto
* -crlf

# Match EditorConfig and Biome on Windows as well as Linux.
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
# Public assets are excluded from Biome; retain their existing line endings.
public/** text=auto !eol
